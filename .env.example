# Spotify direct adapter
# Spotify Dashboard -> app -> Client ID
# Native redirect: music://spotify
# Web builds must also allow the exact redirect URI produced by the deployed app.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Last.fm bridge adapter
# Create an API account/key at Last.fm and expose the public API key here.
# The user supplies their own Last.fm username in the UI.
EXPO_PUBLIC_LASTFM_API_KEY=
